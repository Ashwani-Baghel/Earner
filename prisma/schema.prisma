// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum GigStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  PAUSED
  BANNED
  DELETED
}

model PlatformSettings {
  id        String   @id @default("global")
  data      Json     // Store all settings as a JSON object
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  ACTIVE
  DELIVERED
  REVISION
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  GIG
  MESSAGE
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id          String   @id  // Firebase UID
  email       String   @unique
  name        String
  avatar      String?
  role        Role     @default(BUYER)
  isSeller    Boolean  @default(false)
  isBanned    Boolean  @default(false)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sellerProfile SellerProfile?
  gigsAsSeller  Gig[]          @relation("SellerGigs")
  ordersAsBuyer Order[]        @relation("BuyerOrders")
  ordersAsSeller Order[]       @relation("SellerOrders")
  reviewsGiven  Review[]       @relation("ReviewsByBuyer")
  favorites     Favorite[]     @relation("UserFavorites")
  conversations ConversationParticipant[]
  reportsGiven  Report[]       @relation("ReportsByUser")
  cartItems     CartItem[]
  adminProfile  AdminProfile?
  supportTickets SupportTicket[]
  liveChatSessions LiveChatSession[]
}

// ─── Seller Profile ───────────────────────────────────────────────────────────
model SellerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagline      String?
  bio          String?
  skills       String[]
  languages    String[]
  responseTime String   @default("1 hour")
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  totalOrders  Int      @default(0)
  earnings     Float    @default(0)
  level        String   @default("new") // new | level1 | level2 | top | pro
  
  // Advanced Profile
  occupations       Json?    // Array of { categoryId, categoryName, from, to, subcategories: string[] }
  structuredSkills  Json?    // Array of { name: string, level: string }
  
  // Social Links
  website      String?
  linkedin     String?
  github       String?
  twitter      String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Categories ───────────────────────────────────────────────────────────────
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE | HIDDEN
  seoTitle    String?
  seoDesc     String?
  subcategories SubCategory[]
  gigs        Gig[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubCategory {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String?
  groupName   String?
  image       String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("ACTIVE")
  seoTitle    String?
  seoDesc     String?
  gigs        Gig[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Gig ──────────────────────────────────────────────────────────────────────
model Gig {
  id            String    @id @default(cuid())
  sellerId      String
  seller        User      @relation("SellerGigs", fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   SubCategory? @relation(fields: [subcategoryId], references: [id])
  tags          String[]
  status        GigStatus @default(PENDING)
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  orders        Int       @default(0)
  featured      Boolean   @default(false)
  bestSeller    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  packages      GigPackage[]
  faqs          GigFAQ[]
  requirements  GigRequirement[]
  media         GigMedia[]
  gigOrders     Order[]
  reviews       Review[]
  favorites     Favorite[] @relation("GigFavorites")
  cartItems     CartItem[]
}

// ─── Gig Packages & Features ───────────────────────────────────────────────────
model GigPackage {
  id           String   @id @default(cuid())
  gigId        String
  gig          Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier         String   // BASIC | STANDARD | PREMIUM
  name         String
  description  String
  price        Float
  deliveryDays Int
  revisions    Int      // -1 for unlimited
  features     String[] // Array of included features
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([gigId, tier])
}

model GigFAQ {
  id          String   @id @default(cuid())
  gigId       String
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GigRequirement {
  id          String   @id @default(cuid())
  gigId       String
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  question    String
  type        String   // TEXT | FILE | MULTIPLE_CHOICE
  required    Boolean  @default(true)
  options     String[] // Used for MULTIPLE_CHOICE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GigMedia {
  id          String   @id @default(cuid())
  gigId       String
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  url         String
  type        String   // IMAGE | VIDEO | DOCUMENT
  isPrimary   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  gigId     String
  gig       Gig      @relation("GigFavorites", fields: [gigId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gigId])
}

// ─── Order ────────────────────────────────────────────────────────────────────
model Order {
  id           String      @id @default(cuid())
  gigId        String
  gig          Gig         @relation(fields: [gigId], references: [id])
  buyerId      String
  buyer        User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId     String
  seller       User        @relation("SellerOrders", fields: [sellerId], references: [id])
  packageTier  String      // basic | standard | premium
  price        Float
  status       OrderStatus @default(PENDING)
  requirements String?
  deliverables String[]
  dueDate      DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  paymentIntentId String?  @unique

  review Review?
}

// ─── Review ───────────────────────────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id])
  buyerId   String
  buyer     User     @relation("ReviewsByBuyer", fields: [buyerId], references: [id])
  rating    Float
  comment   String
  createdAt DateTime @default(now())
}

// ─── Reports (Moderation) ─────────────────────────────────────────────────────
model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   User             @relation("ReportsByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTargetType
  targetId   String           // ID of the User / Gig / Message being reported
  reason     String
  details    String?
  status     ReportStatus     @default(OPEN)
  resolvedBy String?          // Admin user ID who resolved
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// ─── Messaging ────────────────────────────────────────────────────────────────
model Conversation {
  id           String                   @id @default(cuid())
  participants ConversationParticipant[]
  messages     Message[]
  lastMessage  String?
  updatedAt    DateTime                 @updatedAt
  createdAt    DateTime                 @default(now())
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount    Int          @default(0)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ─── System Settings ─────────────────────────────────────────────────────────
model SystemSetting {
  id        String   @id @default("global") // We will only have one global record
  feePct    Float    @default(5.0)
  maintenance Boolean @default(false)
  contactEmail String @default("support@earner.com")
  updatedAt DateTime @updatedAt
}

// ─── Persistent Cart ──────────────────────────────────────────────────────────
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier      String   // "basic" | "standard" | "premium"
  createdAt DateTime @default(now())

  @@unique([userId, gigId, tier]) // prevent duplicates
}

// ─── Super Admin & RBAC ───────────────────────────────────────────────────────

model AdminProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String?
  role        AdminRole?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  department  String?           @default("General Support")
  isActive    Boolean           @default(true)
  lastLogin   DateTime?
  permissions AdminPermission[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model AdminRole {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "Moderator", "Support"
  description String?
  permissions RolePermission[]
  admins      AdminProfile[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String            @id @default(cuid())
  name        String            @unique // e.g., "users.view", "orders.manage"
  description String?
  admins      AdminPermission[]
  roles       RolePermission[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model RolePermission {
  roleId       String
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model AdminPermission {
  adminId       String
  admin         AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permissionId  String
  permission    Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@id([adminId, permissionId])
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // e.g., "DELETE_GIG"
  module    String   // e.g., "GIGS"
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ─── Dynamic CMS Configurations ───────────────────────────────────────────────

model CmsConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "HEADER", "FOOTER", "HERO", "HOMEPAGE_SECTIONS", "SEO"
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Blog System ──────────────────────────────────────────────────────────────

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String    @db.Text
  featuredImage   String?
  author          String
  category        String
  tags            String[]
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  publishDate     DateTime?
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Contact Submissions ──────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  subject   String
  name      String
  email     String
  message   String   @db.Text
  status         String   @default("UNREAD") // UNREAD | READ | REPLIED
  userHasUnread  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  assignedTo     String?
  department     String?
  priority       String   @default("Medium") // Low | Medium | High | Urgent
  replies   ContactMessageReply[]
}

model ContactMessageReply {
  id          String         @id @default(cuid())
  inquiryId   String
  inquiry     ContactMessage @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderId    String         // User ID or "SYSTEM" or "AGENT"
  senderRole  String         @default("USER") // USER | AGENT | SYSTEM | NOTE
  message     String         @db.Text
  attachments String[]       @default([])
  isInternal  Boolean        @default(false)
  createdAt   DateTime       @default(now())
}

// ─── Support Tickets ──────────────────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  department  String   // "General Inquiry" | "Billing" | "Technical Support" | "Trust & Safety"
  status      String   @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  assignedTo    String?
  tags          String[]
  messages      SupportTicketMessage[]
  isArchived    Boolean  @default(false)
  userHasUnread Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String        // User ID or "SYSTEM"
  senderRole  String        @default("USER") // USER | AGENT | SYSTEM | NOTE
  message     String        @db.Text
  attachments String[]      @default([]) // URLs to uploaded images/proofs
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

// ─── Live Chat ────────────────────────────────────────────────────────────────

model LiveChatSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String?
  status      String   @default("WAITING") // WAITING | ACTIVE | CLOSED
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  messages    LiveChatMessage[]
}

model LiveChatMessage {
  id          String          @id @default(cuid())
  sessionId   String
  session     LiveChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId    String          // User ID or Agent ID or "SYSTEM"
  message     String          @db.Text
  createdAt   DateTime        @default(now())
}

// ─── Authentication Whitelist ───────────────────────────────────────────

model AllowlistEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
